{
  "name": "@arthur-lobo/zod-env",
  "version": "1.1.0",
  "description": "load and validate your env with zod.",
  "keywords": [
    "zod",
    "env",
    "dotenv",
    "validation"
  ],
  "license": "MIT",
  "author": "Arthur Lobo",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest --run",
    "build": "tsup",
    "prepack": "bun run build"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.0"
}
